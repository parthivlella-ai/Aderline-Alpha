# ==========================================
# Prismora Environment Configuration
# ==========================================
# Copy this file to .env.local and populate with your Supabase credentials:
# cp .env.example .env.local

# Supabase Public Configuration (accessible in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Configuration (Optional for elevated admin operations)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
